<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="state"
            type="com.black.feature.floatingbutton.ui.floating.FloatingViewState" />

        <variable
            name="floatingView"
            type="com.black.feature.floatingbutton.ui.floating.FloatingView" />
    </data>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        backgroundColor="@{0xFF000000}"
        backgroundOpacity="@{state.opacity}"
        backgroundRadius="@{state.radius}"
        paddingDp="@{state.padding}"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{state.clock}"
            android:textSize="13dp"
            android:textColor="#FFFFFF"
            tools:ignore="SpUsage" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                android:scaleType="fitCenter"
                android:onClick="@{_->floatingView.goHome()}"
                android:background="@drawable/bt_ripple"
                sizeDp="@{state.size}"
                marginEndDp="@{state.margin}"
                />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:onClick="@{_->floatingView.goBack()}"
                android:background="@drawable/bt_ripple"
                sizeDp="@{state.size}"
                marginEndDp="@{state.margin}"
                />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_status_bar"
                android:scaleType="fitCenter"
                android:onClick="@{_->floatingView.openStatusBar()}"
                android:background="@drawable/bt_ripple"
                sizeDp="@{state.size}"
                marginEndDp="@{state.margin}"
                />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume_down"
                android:scaleType="fitCenter"
                android:onClick="@{_->floatingView.lowerVolume()}"
                android:background="@drawable/bt_ripple"
                sizeDp="@{state.size}"
                marginEndDp="@{state.margin}"
                />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume_up"
                android:scaleType="fitCenter"
                android:onClick="@{_->floatingView.raiseVolume()}"
                android:background="@drawable/bt_ripple"
                sizeDp="@{state.size}"
                marginEndDp="@{state.margin}"
                />
        </LinearLayout>

    </LinearLayout>
</layout>
