<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 정확한 시각의 알람(Todo 기한 알림) 예약, API 31 이상은 사용자가 설정에서 허용해야 동작 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13 이상 집 도착·시각 알림 표시 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Todo 시각 알림 알람 수신, 앱이 보낸 알람 인텐트만 받음 -->
        <receiver android:name=".receiver.TodoReminderReceiver" android:exported="false" />

        <!-- 정확한 알람 허용 뒤 Todo 시각 알림 다시 예약, 시스템 방송이라 exported이며 수신기가 액션을 확인 -->
        <receiver android:name=".receiver.TodoExactAlarmPermissionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
