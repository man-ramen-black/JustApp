<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 같은 기기의 실사용 debug 앱과 런처·앱 정보에서 구분되는 이름(화면 문구 app_name은 유지) -->
    <application
        android:label="@string/uitest_app_label"
        tools:replace="android:label">

        <!-- 테스트에서 Hilt Fragment를 호스팅하기 위한 전용 Activity 등록 (계측 테스트 빌드 타입 전용) -->
        <!-- 화면 방향을 바꾸는 Fragment를 띄워도 재생성으로 호스팅 콘텐츠가 사라지지 않도록 회전 구성 변경 직접 처리 -->
        <activity
            android:name="com.black.app.testutil.HiltTestActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Black" />
    </application>
</manifest>
