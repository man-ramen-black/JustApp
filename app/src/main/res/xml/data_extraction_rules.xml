<?xml version="1.0" encoding="utf-8"?>
<!--
API 31 이상 클라우드 백업과 기기 이전 규칙(android:dataExtractionRules), 제외 이유는 backup_rules.xml과 같음.
include 없이 exclude만 두어 나머지 앱 데이터는 기본대로 백업·이전.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="UsageLog.db" />
        <exclude domain="database" path="UsageLog.db-wal" />
        <exclude domain="database" path="UsageLog.db-shm" />
        <exclude domain="database" path="UsageLog.db-journal" />
        <exclude domain="file" path="datastore/usage_log.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="UsageLog.db" />
        <exclude domain="database" path="UsageLog.db-wal" />
        <exclude domain="database" path="UsageLog.db-shm" />
        <exclude domain="database" path="UsageLog.db-journal" />
        <exclude domain="file" path="datastore/usage_log.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
