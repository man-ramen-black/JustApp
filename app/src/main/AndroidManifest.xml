<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11 이상에서 QUERY_ALL_PACKAGES 권한 우회 처리 (권장되지 않음...) -->
    <!-- https://soir1984.tistory.com/68 -->
    <queries>
        <intent>
            <action android:name="*" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- BOOT_COMPLETED Broadcast를 받기 위한 권한 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
    https://developer.android.com/guide/components/foreground-services#request-foreground-service-permissions
    Android 9(API 레벨 28) 이상에서 ForegroundService를 사용하기 위한 퍼미션 (퍼미션 허용은 따로 하지 않아도됨)
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14 (API 수준 34) 타겟팅 시 추가 필요 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- Floating View -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Android 13 이상 Notification, Toast 노출을 위한 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 사용 기록: 앱 사용·화면 기록 읽기(UsageStatsManager), 선언이 없으면 설정의 사용 정보 접근 화면에서 허용할 수 없음 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 사용 기록: Wi-Fi 연결 감시와 SSID 읽기(Android 8.1 이상은 위치 권한과 위치 설정이 있어야 SSID가 보임) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- usesCleartextTraffic : https://mrgamza.tistory.com/639 -->
    <!-- 백업 규칙: 기기 사용 기록 DB와 설정만 백업·기기 이전에서 제외(API 30 이하 fullBackupContent, API 31 이상 dataExtractionRules) -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Black"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!--
        [configChanges]
        https://developer.android.com/guide/topics/manifest/activity-element?hl=ko#config
        orientation|screenSize : 화면 회전
        keyboardHidden : 키보드 노출/숨김
        keyboard : 외부 키보드 연결
        uiMode : 다크 모드 전환 등

        [configChanges : Foldable]
        https://developer.samsung.com/sdp/blog/en-us/2019/01/31/how-to-update-your-apps-for-foldable-displays
        https://medium.com/@WeAreMobile1st/how-to-develop-android-apps-for-foldable-devices-950a3b26327f
        screenLayout|smallestScreenSize : 폴더블 접음/펼침 (with resizeableActivity = true)

        [MainActivity configChanges]
        PokeRogue 게임(WebView의 JS 메모리)이 회전·폴더블 접음/펼침으로 끊기지 않도록 재생성 없이 직접 처리.
        방향별 레이아웃(layout-land)은 자동으로 다시 적용되지 않아 그 화면이 onConfigurationChanged에서 교체(PokeRogueFragment).
        앱이 항상 어두운 테마(night 리소스 없음)라 uiMode가 바뀌어도 화면이 달라지지 않아 함께 처리.
        언어·글꼴 크기처럼 지정하지 않은 설정이 바뀌면 재생성되어 게임이 처음부터 시작됨

        [LaunchMode]
        https://developer.android.com/guide/components/activities/tasks-and-back-stack?hl=ko
        https://aroundck.tistory.com/63
        -->
        <activity
            android:name="com.black.app.ui.MainActivity"
            android:theme="@style/Theme.Black.Starting"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true">
            <!-- #Android13에서는 #IntentFilter가 정확히 매칭되야지만 #startActivity가 동작-->
            <!-- https://codechacha.com/ko/android-13-intent-matching/ -->
            <!-- 앱 실행 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- 바로가기 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="black"/>
            </intent-filter>
        </activity>

        <!-- 각 모듈에서 참조할 Notification 아이콘 -->
        <meta-data
            android:name="NOTIFICATION_ICON"
            android:resource="@drawable/ic_notification" />

        <service android:name=".service.ForegroundService"
            android:foregroundServiceType="specialUse" />

        <receiver android:name=".broadcast.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <service android:name=".ui.main.usagetimer.UsageTimerAccessibility"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label_usage_timer"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usage_timer_accessibility_config" />
        </service>

        <!-- 빠른 설정창 화면 켜짐 유지 타일 -->
        <service android:name=".ui.main.keepscreenon.KeepScreenOnTileService"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/ic_keep_screen_on"
            android:label="@string/keep_screen_on_tile_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <!-- 켜짐/꺼짐 스위치형 타일 표시 -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- adb로 화면 켜짐 유지를 켜고 끄는 Receiver (기기 작업 뒤 켜짐 유지 복원용) -->
        <!-- shell은 다른 앱의 비공개 Receiver를 호출할 수 없어 공개하되, shell만 가진 DUMP 권한으로 다른 앱의 호출 차단 -->
        <receiver
            android:name=".ui.main.keepscreenon.KeepScreenOnReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.black.app.action.ACTIVATE_KEEP_SCREEN_ON" />
                <action android:name="com.black.app.action.DEACTIVATE_KEEP_SCREEN_ON" />
            </intent-filter>
        </receiver>

        <!-- 앱 업데이트 설치가 프로세스와 함께 ForegroundService를 종료하므로 실행 설정이 켜져 있으면 재시작 -->
        <receiver android:name=".broadcast.AppUpdateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!--*********************************************-->
        <!-- Shortcut -->
        <!--*********************************************-->
        <activity android:name=".shortcut.MemoShortcutActivity"
            android:label="@string/shortcut_memo_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!--*********************************************-->
        <!-- Shortcut -->
        <!--*********************************************-->

        <!-- 기기 사용 기록용 알림 접근 서비스 -->
        <service
            android:name=".usagelog.collect.UsageLogListenerService"
            android:label="@string/usage_log_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
