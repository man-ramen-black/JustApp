<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- adb로 화면 켜짐 유지를 켜고 끄는 Receiver (debug 전용) -->
        <!-- shell은 다른 앱의 비공개 Receiver를 호출할 수 없어 공개하되, shell만 가진 DUMP 권한으로 다른 앱의 호출 차단 -->
        <receiver
            android:name="com.black.app.ui.main.keepscreenon.KeepScreenOnReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.black.app.action.ACTIVATE_KEEP_SCREEN_ON" />
                <action android:name="com.black.app.action.DEACTIVATE_KEEP_SCREEN_ON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
